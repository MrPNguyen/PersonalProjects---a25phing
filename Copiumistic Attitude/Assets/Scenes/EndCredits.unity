  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Programmer:\nPhilip Nguyen\n\n\n\n\n\n\nGraphic Designer:\nPhilip Nguyen\n\n\n\n\n\n\nGame
    Writer:\nPhilip Nguyen\n\n\n\n\n\nGame Designer:\nPhilip Nguyen\n\n\nVoice Actor:\nPhilip
    Nguyen\n\nTrailer producer/Writer/Editor/Voice Actor:\nPhilip Nguyen\n\nCC0 assets
    used:\n\n\nOpengameart.org:\nBackground: \"Birdhousefield\" - Kutejnikov\nBox:
    \"Rusty Crate\" - Matt Rumble\nShop background: \"Parchment Background\" - Felis
    Chaus\nBorder box around score: \"Fantasy UI Box\" - StumpyStrust\nSpeech Bubbles:
    \"Tiny RPG - Emoji Pack I\" - tiopalada\nCat icon: \"Cat Sprites\" - Shepardskin\nLight
    Door 2 Icon: \"Pixel art door\" - bonzille\n\n\nFont1001:\nMom Letters: \"Youth
    Shandey Font - Artefak Project\nSister Letters: \"First Time Writing!\" - GGBotNet\nDad
    Letters: \"Bodoni Z37\" - Raymond Larabie\nDr Hart Letters: \"Naked Power\" -
    Ramond Larabie\nMind Letters: \"Dirty Enough font\" - zlxvx\n\nFontspace\nScore:
    \"Karmatic Arcade\" - Vic Feiger\nShop: \"Shaga Pixel\" - Craftsupplyco\n\n\n\nOpengameart.org:\nMain
    Game: \"Shop Theme\" - CleytonKauffman\nMain Game Sad Song: \"Complicated Feelings\"
    - Some Weirdo (that's their name not me calling them that)\nMain Menu: \"Free
    Music Pack\" - Tricksntraps\nEnd Credits: \"Free Music Pack\" - Tricksntraps\nBad
    Ending: \"Sad Orchestral Theme\" - Obscure Music\nGood Ending: \"Another Space
    Backgound Track\" - Yd\nPrologue/Trailer: \"Happy Awkward Trumpet\" - GloriaTheAnimator\n\n\n\nfreesound.org\nChair
    dragging: \"Dragging metal chair across concrete floor, indoors 3\" - FOSSarts\nRope
    swinging: \"Rope under tension\" - Gear_Clinkz\nEnvelope: \"FX Envelope Open\"
    - PeteBarry\nEntrance Bell: \"Entrance Bell\" - Zott820\n[Main Menu] Button Click:
    \"DRAMATIC\" - Blonce\nLever Click: \"Wooden Crank, Handle wth rope, winding
    - aUREa\nInsufficient Funds: \"Wrong\" - TheBuilder15\n\nPixabay:\n[Main Menu]
    Button Hover: \"Chime\" - Scratchonix\nPurchase: \"Cha Ching\" - Freesound_Community\n\nOpengameart.org\nMachine
    exploding: \"Heartbeat (Single Sound)\" - Independent.nu\nMachine shutting down:
    \"Forest Ambience\" - TinyWorlds\nHeartbeat: \"Mechanical Explosion\" - Spring
    Spring\nGood Ending Ambians: \"Machine Shutting Down\" - Cough-E\n\n\n\n\n\nAll
    The assets used in this project that are not made by me are CC0\n\n\n\n\n\n\n\n\n\n\n\n\nThank
    You For Playing and if you're \never feeling this way just know:\n\n\n\n\n\nThee
    are people who care, sometimes just \none phone call or reach away."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dcef5f5d86aeafe46a9194b8ceb6261a, type: 2}
