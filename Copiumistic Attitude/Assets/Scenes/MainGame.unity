  - {fileID: 974298183}
  - {fileID: 1291364068}
  - {fileID: 42597815}
  - {fileID: 785597763}
  momLetterInfos:
  - "Hi Honey!\n\n\tCan you do the dishes?\n\t\t\t\t\t\n\t\t\t\tMom"
  - "\n\n\tCan you help me take out the trash?\n\n\t\t\t\tMom"
  - "\n\n\tEverything alright honey?\n\tYou haven't come out of your room for a few
    days. It's not about \n\tme and your father is it?\n\t\n\t\t\t\t\t\t\t\tMom"
  dadLetterInfos:
  - "Heeey sport!\n\t\n\tHow's it going in school? you got a girlfriend yet?\n\n\t\t\t\t\t\t\tDad"
  - "\nHoney, have you made any contact with him recently?\n\n\t\t\t\t\t\t\tDad"
  - "\nHey can you at least make an effort to get along with her! She is your mother
    too you know!\n\n\t\t\t\t\t\t\tDad"
  sisterLetterInfos:
  - "\t\n\tHey can I borrow your jacket for the day?\n\n\t\t\t\t\t\t\t\tCassy"
  - "\t\n\tHey can I borrow one of your notebooks? I'm all out\n\n\t\t\t\t\t\t\t\t\tCassy"
  - "\t\n\tHey have you seen our cat?\n\n\t\t\t\t\t\tCassy"
  drHartLetterInfos:
  - '

    How has your day been?'
  - '

    Do you want to talk about your father and mother?'
  - '

    Coming in is the hardest step, but I believe you can do it'
  - '

    You are worth it, I promise'
  mindLetterInfos:
  - "\n\tWhy are you such a burden to your family?"
  - "\n\tWhy can't you just accept the help? Are you afraid?"
  - "\n\tYou know what you are not even worth the help"
  - "\n\tYou do know that no one truly wants you here right?"
  - "\n\tEnd it."
  ending: {fileID: 166938723}
  endingAnim: {fileID: 1282483449}
  screenShake: {fileID: 519420033}
  duration: 1
  cat: {fileID: 893006005}
